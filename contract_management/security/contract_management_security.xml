<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_contract_management" model="ir.module.category">
            <field name="name">Contract Management</field>
            <field name="description">Access rights for the Contract Management application.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_contract_legal_user" model="res.groups">
            <field name="name">Legal User</field>
            <field name="category_id" ref="module_category_contract_management"/>
            <field name="comment">Can create and manage contracts and view approved templates.</field>
        </record>

        <record id="group_contract_legal_manager" model="res.groups">
            <field name="name">Legal Manager</field>
            <field name="category_id" ref="module_category_contract_management"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_legal_user'))]"/>
            <field name="comment">Can create/approve templates and manage the full contract workflow.</field>
        </record>

        <record id="group_contract_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_contract_management"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_legal_manager'))]"/>
            <field name="comment">Full technical access: security configuration, all companies.</field>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>

    </data>
</odoo>

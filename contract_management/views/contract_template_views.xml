<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_contract_template_list" model="ir.ui.view">
            <field name="name">contract.template.list</field>
            <field name="model">contract.template</field>
            <field name="arch" type="xml">
                <list string="Contract Templates" decoration-muted="state == 'archived'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="version"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="article_count"/>
                    <field name="variable_count"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'approved'"
                           decoration-info="state == 'draft'"
                           decoration-muted="state == 'archived'"/>
                </list>
            </field>
        </record>

        <record id="view_contract_template_kanban" model="ir.ui.view">
            <field name="name">contract.template.kanban</field>
            <field name="model">contract.template</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="version"/>
                    <field name="state"/>
                    <field name="article_count"/>
                    <field name="variable_count"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click p-2">
                                <strong><field name="name"/></strong>
                                <div class="text-muted">
                                    <field name="code"/> - v<field name="version"/>
                                </div>
                                <div>
                                    <span class="badge badge-pill badge-info">
                                        <field name="article_count"/> Articles
                                    </span>
                                    <span class="badge badge-pill badge-secondary">
                                        <field name="variable_count"/> Variables
                                    </span>
                                </div>
                                <field name="state" widget="badge"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_contract_template_form" model="ir.ui.view">
            <field name="name">contract.template.form</field>
            <field name="model">contract.template</field>
            <field name="arch" type="xml">
                <form string="Contract Template">
                    <header>
                        <button name="action_approve" type="object" string="Approve"
                                class="oe_highlight" invisible="state != 'draft'"
                                groups="contract_management.group_contract_legal_manager"/>
                        <button name="action_reset_draft" type="object" string="Reset to Draft"
                                invisible="state != 'approved'"
                                groups="contract_management.group_contract_legal_manager"/>
                        <button name="action_archive_template" type="object" string="Archive"
                                invisible="state == 'archived'"
                                groups="contract_management.group_contract_legal_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_articles" type="object" class="oe_stat_button" icon="fa-list-alt">
                                <field name="article_count" widget="statinfo" string="Articles"/>
                            </button>
                            <button name="action_view_variables" type="object" class="oe_stat_button" icon="fa-code">
                                <field name="variable_count" widget="statinfo" string="Variables"/>
                            </button>
                            <button name="action_view_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="contract_count" widget="statinfo" string="Contracts"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="state != 'archived'"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Standard NDA"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="version"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <field name="description" placeholder="Internal description of this template..."/>
                        <notebook>
                            <page string="Articles" name="articles">
                                <field name="article_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="clause_count"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Variables" name="variables">
                                <field name="variable_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="data_type"/>
                                        <field name="required"/>
                                        <field name="default_value"/>
                                        <field name="example_value"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_contract_template_search" model="ir.ui.view">
            <field name="name">contract.template.search</field>
            <field name="model">contract.template</field>
            <field name="arch" type="xml">
                <search string="Search Templates">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                    <separator/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="action_contract_template" model="ir.actions.act_window">
            <field name="name">Contract Templates</field>
            <field name="res_model">contract.template</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'search_default_filter_approved': 0}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first contract template
                </p>
                <p>
                    Templates group Articles and Clauses with dynamic
                    Variables that can later be filled in when generating a
                    real Contract.
                </p>
            </field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="portal_my_home_contract_menu" name="Contracts Menu" inherit_id="portal.portal_breadcrumbs" priority="30">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'contract' or contract" t-attf-class="breadcrumb-item #{'active ' if not contract else ''}">
                    <a t-if="contract" t-attf-href="/my/contracts?{{ keep_query() }}">Contracts</a>
                    <t t-else="">Contracts</t>
                </li>
                <li t-if="contract" class="breadcrumb-item active">
                    <t t-esc="contract.reference"/>
                </li>
            </xpath>
        </template>

        <template id="portal_my_home_contract" name="Portal My Home: Contracts" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Contracts</t>
                    <t t-set="url" t-value="'/my/contracts'"/>
                    <t t-set="count" t-value="contract_count"/>
                </t>
            </xpath>
        </template>

        <template id="portal_my_contracts" name="My Contracts">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Contracts</t>
                </t>
                <t t-if="not contracts">
                    <p>There are currently no contracts for your account.</p>
                </t>
                <t t-if="contracts" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Reference</th>
                            <th>Template</th>
                            <th>Contract Date</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="contracts" t-as="contract">
                            <td>
                                <a t-attf-href="/my/contracts/#{contract.id}?{{ keep_query() }}">
                                    <t t-esc="contract.reference"/>
                                </a>
                            </td>
                            <td><t t-esc="contract.template_id.name"/></td>
                            <td><t t-esc="contract.contract_date"/></td>
                            <td><t t-esc="contract.expiry_date"/></td>
                            <td><span t-esc="contract.state"/></td>
                        </tr>
                    </tbody>
                </t>
            </t>
        </template>

        <template id="portal_contract_page" name="Contract Portal Detail">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="False"/>
                <div class="row">
                    <div class="col-12">
                        <h3>
                            Contract <t t-esc="contract.reference"/>
                            <span class="badge badge-pill badge-info" t-esc="contract.state"/>
                        </h3>
                        <p>
                            <a t-attf-href="/my/contracts/#{contract.id}/pdf" class="btn btn-primary"
                               t-if="contract.generated_pdf">
                                <i class="fa fa-download"/> Download PDF
                            </a>
                        </p>
                        <div t-raw="contract.generated_html"/>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_contract_contract_list" model="ir.ui.view">
            <field name="name">contract.contract.list</field>
            <field name="model">contract.contract</field>
            <field name="arch" type="xml">
                <list string="Contracts" decoration-danger="is_expired" decoration-warning="expiring_soon">
                    <field name="reference"/>
                    <field name="partner_id"/>
                    <field name="template_id"/>
                    <field name="contract_date"/>
                    <field name="expiry_date"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="is_expired" invisible="1"/>
                    <field name="expiring_soon" invisible="1"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'signed'"
                           decoration-info="state in ('draft', 'review')"
                           decoration-warning="state == 'approved'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="view_contract_contract_form" model="ir.ui.view">
            <field name="name">contract.contract.form</field>
            <field name="model">contract.contract</field>
            <field name="arch" type="xml">
                <form string="Contract">
                    <header>
                        <button name="action_submit_review" type="object" string="Submit for Review"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="oe_highlight" invisible="state != 'review'"
                                groups="contract_management.group_contract_legal_manager"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state not in ('review', 'approved')"
                                groups="contract_management.group_contract_legal_manager"/>
                        <button name="action_sign" type="object" string="Sign"
                                class="oe_highlight" invisible="state != 'approved'"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('signed', 'cancelled', 'archived')"/>
                        <button name="action_archive_contract" type="object" string="Archive"
                                invisible="state not in ('signed', 'cancelled')"/>
                        <button name="action_reset_draft" type="object" string="Reset to Draft"
                                invisible="state not in ('cancelled',)"
                                groups="contract_management.group_contract_legal_manager"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,review,approved,signed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_print_pdf" type="object" class="oe_stat_button" icon="fa-file-pdf-o"
                                    invisible="not generated_pdf">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Contract PDF</span>
                                </div>
                            </button>
                            <button name="action_view_pdf_history" type="object" class="oe_stat_button" icon="fa-history">
                                <field name="activity_history_count" widget="statinfo" string="History"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="not is_expired"/>
                        <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning" invisible="not expiring_soon"/>
                        <div class="oe_title">
                            <h1><field name="reference" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="template_id" options="{'no_create': True}"/>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="contract_date"/>
                                <field name="effective_date"/>
                                <field name="expiry_date"/>
                                <field name="is_expired" invisible="1"/>
                                <field name="expiring_soon" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Variable Values" name="variable_values">
                                <button name="action_get_default_variables" type="object"
                                        string="Reload Variables from Template" class="btn-secondary mb-2"/>
                                <field name="variable_value_ids">
                                    <list editable="bottom">
                                        <field name="variable_id" readonly="1"/>
                                        <field name="data_type" invisible="1"/>
                                        <field name="required" invisible="1"/>
                                        <field name="value_char"
                                               column_invisible="parent.state == 'nothing'"
                                               invisible="data_type not in ('char', 'selection')"/>
                                        <field name="value_integer" invisible="data_type != 'integer'"/>
                                        <field name="value_float" invisible="data_type != 'float'"/>
                                        <field name="value_date" invisible="data_type != 'date'"/>
                                        <field name="value_datetime" invisible="data_type != 'datetime'"/>
                                        <field name="value_boolean" invisible="data_type != 'boolean'"/>
                                        <field name="value_many2one_id"
                                               invisible="data_type not in ('partner','company','employee','user','many2one')"/>
                                        <field name="value_many2one_name" readonly="1"
                                               invisible="data_type not in ('partner','company','employee','user','many2one')"/>
                                    </list>
                                </field>
                                <button name="action_generate_preview" type="object"
                                        string="Refresh Preview" class="btn-primary mt-2"/>
                            </page>
                            <page string="Live Preview" name="live_preview">
                                <field name="id" invisible="1"/>
                                <widget name="contract_live_preview"/>
                            </page>
                            <page string="Generated Document" name="generated_document">
                                <field name="generated_html" widget="html" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_contract_contract_search" model="ir.ui.view">
            <field name="name">contract.contract.search</field>
            <field name="model">contract.contract</field>
            <field name="arch" type="xml">
                <search string="Search Contracts">
                    <field name="reference"/>
                    <field name="partner_id"/>
                    <field name="template_id"/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Review" name="filter_review" domain="[('state', '=', 'review')]"/>
                    <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Signed" name="filter_signed" domain="[('state', '=', 'signed')]"/>
                    <filter string="Expiring Soon" name="filter_expiring_soon" domain="[('expiring_soon', '=', True)]"/>
                    <filter string="Expired" name="filter_expired" domain="[('is_expired', '=', True)]"/>
                    <separator/>
                    <filter string="Contract Date" name="filter_date" date="contract_date"/>
                    <separator/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Template" name="group_template" context="{'group_by': 'template_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </search>
            </field>
        </record>

        <record id="view_contract_contract_calendar" model="ir.ui.view">
            <field name="name">contract.contract.calendar</field>
            <field name="model">contract.contract</field>
            <field name="arch" type="xml">
                <calendar string="Contracts" date_start="expiry_date" color="state" mode="month">
                    <field name="reference"/>
                    <field name="partner_id"/>
                </calendar>
            </field>
        </record>

        <record id="view_contract_contract_pivot" model="ir.ui.view">
            <field name="name">contract.contract.pivot</field>
            <field name="model">contract.contract</field>
            <field name="arch" type="xml">
                <pivot string="Contracts Analysis">
                    <field name="template_id" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="view_contract_contract_graph" model="ir.ui.view">
            <field name="name">contract.contract.graph</field>
            <field name="model">contract.contract</field>
            <field name="arch" type="xml">
                <graph string="Contracts Analysis" type="bar">
                    <field name="state"/>
                </graph>
            </field>
        </record>

        <record id="action_contract_contract" model="ir.actions.act_window">
            <field name="name">Contracts</field>
            <field name="res_model">contract.contract</field>
            <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
            <field name="context">{'search_default_group_state': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first contract
                </p>
                <p>Pick an approved template, fill in the variables and generate the final document.</p>
            </field>
        </record>

    </data>
</odoo>

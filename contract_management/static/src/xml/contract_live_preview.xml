<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="contract_management.ContractLivePreview">
        <div class="o_contract_live_preview">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">Live Preview</h5>
                <button type="button" class="btn btn-sm btn-secondary" t-on-click="onRefreshClick">
                    <i class="fa fa-refresh"/> Refresh
                </button>
            </div>
            <div t-if="state.loading" class="text-muted">
                <i class="fa fa-spinner fa-spin"/> Rendering preview...
            </div>
            <div t-if="state.error" class="alert alert-danger" role="alert">
                <t t-esc="state.error"/>
            </div>
            <div class="o_contract_live_preview_content border rounded p-3" t-out="state.html"/>
        </div>
    </t>

</templates>

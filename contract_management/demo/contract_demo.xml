<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="demo_template_nda" model="contract.template">
            <field name="name">Standard Non-Disclosure Agreement</field>
            <field name="code">NDA-STD</field>
            <field name="version">1.0</field>
            <field name="description">Mutual NDA template used for demo purposes.</field>
            <field name="state">approved</field>
        </record>

        <record id="demo_article_1" model="contract.article">
            <field name="template_id" ref="demo_template_nda"/>
            <field name="sequence">10</field>
            <field name="name">1. Definitions</field>
            <field name="description">This article defines the key terms used throughout the agreement.</field>
        </record>

        <record id="demo_clause_1_1" model="contract.clause">
            <field name="article_id" ref="demo_article_1"/>
            <field name="sequence">10</field>
            <field name="name">1.1 Confidential Information</field>
            <field name="mandatory">True</field>
            <field name="body"><![CDATA[<p>This Agreement is entered into between {{Company}} and {{PartnerName}} on {{ContractDate}}.</p>]]></field>
        </record>

        <record id="demo_article_2" model="contract.article">
            <field name="template_id" ref="demo_template_nda"/>
            <field name="sequence">20</field>
            <field name="name">2. Obligations</field>
        </record>

        <record id="demo_clause_2_1" model="contract.clause">
            <field name="article_id" ref="demo_article_2"/>
            <field name="sequence">10</field>
            <field name="name">2.1 Duration</field>
            <field name="mandatory">True</field>
            <field name="body"><![CDATA[<p>The confidentiality obligations under this Agreement shall remain in effect for {{DurationYears}} years from {{Today}}.</p>]]></field>
        </record>

        <record id="demo_variable_duration" model="contract.variable">
            <field name="template_id" ref="demo_template_nda"/>
            <field name="name">Duration (Years)</field>
            <field name="code">DurationYears</field>
            <field name="data_type">integer</field>
            <field name="required">True</field>
            <field name="default_value">2</field>
            <field name="example_value">5</field>
        </record>

        <record id="demo_contract_1" model="contract.contract">
            <field name="partner_id" ref="base.res_partner_1"/>
            <field name="template_id" ref="demo_template_nda"/>
            <field name="contract_date" eval="(DateTime.today()).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(DateTime.today() + relativedelta(years=2)).strftime('%Y-%m-%d')"/>
        </record>

    </data>
</odoo>

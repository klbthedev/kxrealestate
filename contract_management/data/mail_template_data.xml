<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_contract_expiry_reminder" model="mail.template">
            <field name="name">Contract: Expiry Reminder</field>
            <field name="model_id" ref="model_contract_contract"/>
            <field name="subject">Your contract {{ object.reference }} is expiring soon</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.partner_id.name or ''"/>,</p>
    <p>
        This is a reminder that contract <strong t-out="object.reference or ''"/>
        is due to expire on <strong t-out="object.expiry_date or ''"/>.
    </p>
    <p>Please contact us if you wish to renew or discuss this contract.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name or ''"/></p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_contract_approval_reminder" model="mail.template">
            <field name="name">Contract: Approval Reminder</field>
            <field name="model_id" ref="model_contract_contract"/>
            <field name="subject">Contract {{ object.reference }} is awaiting your approval</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
    <p>
        Contract <strong t-out="object.reference or ''"/> for
        <strong t-out="object.partner_id.name or ''"/> is currently in
        <strong t-out="object.state or ''"/> status and awaiting your review/approval.
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>

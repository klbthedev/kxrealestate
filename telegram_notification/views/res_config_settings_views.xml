<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tnc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tnc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Telegram Notification Center" name="tnc_block">
                    <setting string="Enable Telegram Notifications">
                        <field name="tnc_telegram_enabled"/>
                    </setting>
                    <setting string="Telegram Bot Token">
                        <field name="tnc_telegram_bot_token" password="True"/>
                    </setting>
                    <setting string="Telegram Chat ID">
                        <field name="tnc_telegram_chat_id"/>
                    </setting>
                    <setting string="Low Stock Threshold">
                        <field name="tnc_low_stock_threshold"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

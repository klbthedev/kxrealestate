<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_contract_clause_list" model="ir.ui.view">
            <field name="name">contract.clause.list</field>
            <field name="model">contract.clause</field>
            <field name="arch" type="xml">
                <list string="Clauses" > <!-- editable="bottom" -->
                    <field name="sequence" widget="handle"/>
                    <field name="article_id" invisible="context.get('default_article_id')"/>
                    <field name="name"/>
                    <field name="mandatory"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_contract_clause_form" model="ir.ui.view">
            <field name="name">contract.clause.form</field>
            <field name="model">contract.clause</field>
            <field name="arch" type="xml">
                <form string="Clause">
                    <sheet>
                        <group>
                            <field name="article_id" invisible="context.get('default_article_id')"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="mandatory"/>
                            <field name="active"/>
                        </group>
                        <separator string="Clause Body"/>
                        <field name="body" widget="html" options="{'style-inline': true}" placeholder="Example:{{CustomerName}}, {{BuildingAddress}}, {{CompanyVAT}}"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_contract_clause_search" model="ir.ui.view">
            <field name="name">contract.clause.search</field>
            <field name="model">contract.clause</field>
            <field name="arch" type="xml">
                <search string="Search Clauses">
                    <field name="name"/>
                    <field name="article_id"/>
                    <field name="template_id"/>
                    <filter string="Mandatory" name="filter_mandatory" domain="[('mandatory', '=', True)]"/>
                    <filter string="Article" name="group_article" context="{'group_by': 'article_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_contract_clause" model="ir.actions.act_window">
            <field name="name">Clauses</field>
            <field name="res_model">contract.clause</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_contract_clause_list" name="Clauses"
                  parent="menu_contract_header" action="action_contract_clause" sequence="30"/>

    </data>
</odoo>

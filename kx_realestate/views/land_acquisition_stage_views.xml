<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <record id="land_acquisition_stage_view_tree" model="ir.ui.view">
      <field name="name">land.acquisition.stage.tree</field>
      <field name="model">land.acquisition.stage</field>
      <field name="arch" type="xml">
         <list editable="bottom">
            <field name="sequence" />
            <field name="name" />
            <field name="probability" />
            <field name="fold" />
            <field name="active" />
         </list>
      </field>
   </record>
   <record id="land_acquisition_stage_view_form" model="ir.ui.view">
      <field name="name">land.acquisition.stage.form</field>
      <field name="model">land.acquisition.stage</field>
      <field name="arch" type="xml">
         <form>
            <sheet>
               <group>
                  <field name="name" />
                  <field name="sequence" />
                  <field name="probability" />
                  <field name="fold" />
                  <field name="active" />
               </group>
               <group>
                  <field name="description" />
               </group>
            </sheet>
         </form>
      </field>
   </record>
   <record id="action_land_acquisition_stage" model="ir.actions.act_window">
      <field name="name">Acquisition Stages</field>
      <field name="res_model">land.acquisition.stage</field>
      <field name="view_mode">list,form</field>
   </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <record id="land_acquisition_form_documents_button" model="ir.ui.view">
      <field name="name">land.acquisition.documents.button</field>
      <field name="model">land.acquisition</field>
      <field name="inherit_id" ref="kx_realestate.land_acquisition_view_form" />
      <field name="arch" type="xml">
         <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
               <field name="document_count" widget="statinfo" string="Documents" />
            </button>
         </xpath>
      </field>
   </record>
   <record id="site_acquisition_button" model="ir.ui.view">
      <field name="name">site.acquisition.button</field>
      <field name="model">re.site</field>
      <field name="inherit_id" ref="kx_realestate.re_site_view_form" />
      <field name="arch" type="xml">
         <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_view_acquisition_documents" type="object" class="oe_stat_button" icon="fa-file">
               <field name="acquisition_document_count" widget="statinfo" string="Documents" />
            </button>
         </xpath>
      </field>
   </record>
   <record id="building_acquisition_button" model="ir.ui.view">
      <field name="name">building.acquisition.button</field>
      <field name="model">building.building</field>
      <field name="inherit_id" ref="kx_realestate.building_view_form" />
      <field name="arch" type="xml">
         <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_view_acquisition_documents" type="object" class="oe_stat_button" icon="fa-file">
               <field name="acquisition_document_count" widget="statinfo" string="Documents" />
            </button>
         </xpath>
      </field>
   </record>
</odoo>

<odoo>
    <record id="site_city_view_list" model="ir.ui.view">
        <field name="name">site.city.list</field>
        <field name="model">site.city</field>
        <field name="arch" type="xml">            
            <list editable="bottom" sample="1">
                <field name="name"/>
                <field name="region_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <record id="site_city_view_form" model="ir.ui.view">
        <field name="name">site.city.form</field>
        <field name="model">site.city</field>
        <field name="arch" type="xml">
            <form string="Floor">                
                <field name="name"/>
                <field name="region_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="site_city_action" model="ir.actions.act_window">
        <field name="name">City Names</field>
        <field name="res_model">site.city</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_site_city" name="City Names" parent="menu_settings" action="site_city_action" sequence="41"/>
    
</odoo>

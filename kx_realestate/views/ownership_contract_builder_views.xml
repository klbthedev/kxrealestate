<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="ownership_contract_item_category_tree" model="ir.ui.view">
        <field name="name">ownership.contract.item.category.tree</field>
        <field name="model">ownership.contract.item.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ownership_contract_item_category_form" model="ir.ui.view">
        <field name="name">ownership.contract.item.category.form</field>
        <field name="model">ownership.contract.item.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ownership_contract_item_category_action" model="ir.actions.act_window">
        <field name="name">Contract Item Categories</field>
        <field name="res_model">ownership.contract.item.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ownership_contract_clause_tree" model="ir.ui.view">
        <field name="name">ownership.contract.clause.tree</field>
        <field name="model">ownership.contract.clause</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>



    <record id="ownership_contract_clause_form" model="ir.ui.view">
        <field name="name">ownership.contract.clause.form</field>
        <field name="model">ownership.contract.clause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Clause Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="category_id"/>
                                    <field name="name"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>




    <record id="ownership_contract_clause_action" model="ir.actions.act_window">
        <field name="name">Contract Clauses</field>
        <field name="res_model">ownership.contract.clause</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="ownership_contract_category_menu"
        name="Item Categories"
        parent="menu_settings"
        action="ownership_contract_item_category_action"
        sequence="10"
        />

    <menuitem
        id="ownership_contract_clause_menu"
        name="Contract Clauses"
        parent="menu_settings"
        action="ownership_contract_clause_action"
        sequence="20"
        />

</odoo>
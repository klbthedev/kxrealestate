<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salesperson_commission_line_tree" model="ir.ui.view">
        <field name="name">salesperson.commission.line.list</field>
        <field name="model">salesperson.commission.line</field>
        <field name="arch" type="xml">
            <list string="Salesperson Commission Lines" default_order="release_date desc, id desc">
                <field name="release_date"/>
                <!-- <field name="user_id" widget="many2one_avatar_user"/> -->
                <field name="sales_person"/>
                <field name="contract_id"/>
                <field name="installment_id" optional="hide"/>
                <field name="payment_id" optional="hide"/>
                <field name="commission_release_policy" optional="show"/>
                <field name="amount_base"/>
                <field name="commission_percent"/>
                <field name="amount" sum="Total Commission"/>
                
                <field name="vendor_bill_id"/>
                <field name="vendor_bill_state" widget="badge" 
                       decoration-info="vendor_bill_state == 'draft'"
                       decoration-success="vendor_bill_state == 'posted'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_salesperson_commission_line_form" model="ir.ui.view">
        <field name="name">salesperson.commission.line.form</field>
        <field name="model">salesperson.commission.line</field>
        <field name="arch" type="xml">
            <form string="Salesperson Commission Line">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_set_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'confirmed' or vendor_bill_id"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state == 'cancelled' or vendor_bill_id"/>
                    <button name="action_create_vendor_bill"
                            type="object"
                            string="Create Vendor Bill"
                            class="btn-primary"
                            invisible="state != 'confirmed' or vendor_bill_id"/>

                </header>
                <sheet>
                    <!-- Smart Button Container -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vendor_bill"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="vendor_bill_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="vendor_bill_count"/>
                                </span>
                                <span class="o_stat_text">Vendor Bill(s)</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group name="salesperson_info" string="Sales Details" readonly="state != 'draft'">
                            <!-- <field name="user_id" widget="many2one_avatar_user"/> -->
                            <field name="sales_person" readonly="vendor_bill_id != False"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="parent_commission_id" invisible="1"/>
                        </group>
                        <group name="dates_info" string="Schedule" readonly="state != 'draft'">
                            <field name="release_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="financials" string="Calculations" readonly="state != 'draft'">
                            <field name="existing_contract_ids" invisible="1"/>
                            <field name="contract_id" readonly="vendor_bill_id != False or parent_commission_id != False" domain="[('id', 'not in', existing_contract_ids)]"/>

                            <field name="amount_base" readonly="vendor_bill_id != False or parent_commission_id != False"/>
                            <label for="commission_percent"/>
                            <div class="o_row">
                                <field name="commission_percent" readonly="vendor_bill_id != False or parent_commission_id != False"/>
                                <span>%</span>
                            </div>
                            <field name="commission_release_policy" readonly="vendor_bill_id != False or parent_commission_id != False"/>
                            
                            <field name="amount" readonly="vendor_bill_id != False or parent_commission_id != False"/>
                        </group>
                        
                    </group>

                    <!-- Installments Notebook Tab (displays if policy is per installment payment) -->
                    <notebook invisible="commission_release_policy != 'on_payment' or parent_commission_id != False">
                        <page string="Installment Commissions" name="installments">
                            <field name="installment_commission_ids" mode="list" readonly="1">
                                <list string="Installments" create="0" delete="0" edit="0">
                                    <field name="installment_id"/>
                                    <field name="amount_base" string="Installment Base"/>
                                    <field name="commission_percent"/>
                                    <field name="amount" string="Commission Amount" sum="Total Installment Commissions"/>

                                    <button name="action_create_vendor_bill" 
                                            string="Create Vendor Bill" 
                                            type="object" 
                                            class="oe_highlight custom_line" 
                                            colspan="2"
                                            invisible="vendor_bill_id != False"/>
                                </list>
                            </field>
                            
                        </page>
                    </notebook>

                    <group name="notes" string="Internal Notes">
                        <field name="note" placeholder="Add any descriptive notes regarding this commission line here..." colspan="2" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salesperson_commission_line_search" model="ir.ui.view">
        <field name="name">salesperson.commission.line.search</field>
        <field name="model">salesperson.commission.line</field>
        <field name="arch" type="xml">
            <search string="Search Commission Lines">
                <!-- <field name="user_id"/> -->
                <field name="sales_person"/>
                <field name="contract_id"/>
                <field name="payment_id"/>
                <field name="note"/>
                <separator/>
                <filter string="Release Date" name="filter_release_date" date="release_date"/>

                <group expand="0" string="Group By">
                    <!-- <filter string="Salesperson" name="group_by_user_id" context="{'group_by': 'user_id'}"/> -->
                    <filter string="Sales Person Partner" name="group_by_sales_person" context="{'group_by': 'sales_person'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Contract" name="group_by_contract_id" context="{'group_by': 'contract_id'}"/>
                    <filter string="Release Month" name="group_by_release_date" context="{'group_by': 'release_date:month'}"/>
                </group>
            </search>
                </field>

    </record>

    <record id="action_salesperson_commission_line" model="ir.actions.act_window">
        <field name="name">Salesperson Commission</field>
        <field name="res_model">salesperson.commission.line</field>
        <field name="view_mode">list,form,search</field>
        <!-- <search_view_id ref="view_salesperson_commission_line_search"/> -->
    </record>

    <menuitem id="menu_salesperson_commission_line" 
              name="Commission" 
              parent="menu_kx_real_estate" 
              active='False'
              action="action_salesperson_commission_line" 
              sequence="40"/>

</odoo>
<odoo>
    <record id="site_region_view_list" model="ir.ui.view">
        <field name="name">site.region.list</field>
        <field name="model">site.region</field>
        <field name="arch" type="xml">            
            <list editable="bottom" sample="1">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="site_region_view_form" model="ir.ui.view">
        <field name="name">site.region.form</field>
        <field name="model">site.region</field>
        <field name="arch" type="xml">
            <form string="Floor">                
                <field name="name"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="site_region_action" model="ir.actions.act_window">
        <field name="name">Region Names</field>
        <field name="res_model">site.region</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_site_region" name="Region Names" parent="menu_settings" action="site_region_action" sequence="42"/>
    
</odoo>

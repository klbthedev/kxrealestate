<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="kx_realestate.Dashboard">
        <div class="container-fluid p-4 dashboard_container">
            
            <!-- Filters ##########################################################################-->
            
            <div class="row mx-auto">
                <div class="col-md-10 ps-0">
                    <h3 class="mb-4">Dashboard</h3>                    
                </div>                
                <div class="col-md-2 pe-0 text-end">
                    <button class="btn btn-sm" style="background-color: #643F49;color:white;" t-on-click="exportExcel">Export to Excel</button>
                </div>
            </div>

            <!-- Filtering  #########################################################################-->

            <div class="row mx-auto mb-5 pt-2" style="border-top:2px solid #643F49;">
                <div class="col-md-4"></div>
                <div class="col-md-8">
                    <div class="row">
                        <div class="col-md-1"></div>
                        <div class="col-md-2">
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'site.region'"
                                    value="state.region"
                                    update.bind="onRegionSelected"
                                    getDomain.bind="getRegionDomain"
                                    context="getContext()"
                                    activeActions="activeActions"
                                    fieldString="'Region'"
                                    isToMany="false"
                                    placeholder="'Select Region'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'site.city'"
                                    value="state.city"
                                    update.bind="onCitySelected"
                                    getDomain.bind="getCityDomain"
                                    context="getContext()"
                                    activeActions="activeActions"
                                    fieldString="'City'"
                                    isToMany="false"
                                    placeholder="'Select City'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'re.site'"
                                    value="state.site"
                                    update.bind="onSiteSelected"
                                    getDomain.bind="getSiteDomain"
                                    context="getContext()"
                                    activeActions="activeActions"
                                    fieldString="'Site'"
                                    isToMany="false"
                                    placeholder="'Select Site'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'building.building'"
                                    value="state.building"
                                    update.bind="onBuildingSelected"
                                    getDomain.bind="getBuildingDomain"
                                    context="getContext()"
                                    activeActions="activeActions"
                                    fieldString="'Building'"
                                    isToMany="false"
                                    placeholder="'Select Building'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'re.floor'"
                                    value="state.floor"
                                    update.bind="onFloorSelected"
                                    getDomain.bind="getFloorDomain"
                                    context="getContext()"
                                    activeActions="activeActions"
                                    fieldString="'Floor'"
                                    isToMany="false"
                                    placeholder="'Select Floor'"
                                />
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="row align-items-right">
                                <button class="btn btn-sm" style="background-color: #643F49;color:white;" t-on-click="applyFilter">Filter</button>
                            </div>
                        </div>
                    </div>
                </div>                
            </div>            
            
            <!-- ###################################################################################-->
            
            <div class="row mb-3 mt-2">
                <div class="col-md-6">
                    <div class="card dashboard-card shadow-sm" style="background-color: #F5EEF0; cursor: pointer;" 
                        t-on-click="() => this.openTotalCollectedAmount()">
                        <div class="card-body pt-2 pb-0 text-center">
                            <div class="row text-white">
                                <h2 style="text-color: #7A4E59">Total Collected Amount (ETB)</h2>
                            </div>
                            <div class="row text-white">
                                <h2 style="text-color: #7A4E59">
                                    <t t-esc="formatAmount(state.total_paid_amount)"/>
                                    (<t t-esc="formatAmount(state.total_paid_amount_percent)"/>%)
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6"> 
                    <div class="card dashboard-card shadow-sm" style="background-color: #F5EEF0; cursor: pointer;" 
                        t-on-click="() => this.openTotalRemainingAmount()">
                        <div class="card-body pt-2 pb-0 text-center">
                            <div class="row text-white">
                                <h2 style="text-color: #7A4E59">Total Remaining Amount (ETB)</h2>
                            </div>
                            <div class="row text-white">
                                <h2 style="text-color: #7A4E59">
                                    <t t-esc="formatAmount(state.total_remaining_amount)"/>
                                    (<t t-esc="formatAmount(state.total_remaining_amount_percent)"/>%)
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ####################################################################################-->
            
            <div class="row mb-5 my-3">
                <div class="col-md-2">
                    <div class="card dashboard-card shadow-sm" style="background-color: #F5EEF0; cursor: pointer;" 
                        t-on-click="() => this.openAvailableProperties()">
                        <div class="card-body pt-1 pb-0 text-center">
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 px-0 small" style="text-color: #7A4E59">Total Available</h6>
                            </div>
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Units</h6>
                            </div>
                            <div class="row">
                                <h3 style="text-color: #7A4E59">
                                    <t t-esc="state.available_units_count"/>
                                    (<t t-esc="formatAmount(state.available_units_percent)"/>%)
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card shadow-sm" style="background-color: #E6D8DC; cursor:pointer;" 
                        t-on-click="() => this.openSoldProperties()">
                        <div class="card-body pt-1 pb-0 text-center">
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Total Sold</h6>
                            </div>
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Units</h6>
                            </div>
                            <div class="row">
                                <h3 style="text-color: #7A4E59">
                                    <t t-esc="state.sold_units_count"/>
                                    (<t t-esc="formatAmount(state.sold_units_percent)"/>%)
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card shadow-sm" style="background-color: #E6D8DC; cursor:pointer;" 
                        t-on-click="() => this.openReservedProperties()">
                        <div class="card-body pt-1 pb-0 text-center">
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Total Researved</h6>
                            </div>
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Units</h6>
                            </div>
                            <div class="row">
                                <h3 style="text-color: #7A4E59">
                                    <t t-esc="state.blocked_units_count"/>
                                    (<t t-esc="formatAmount(state.blocked_units_percent)"/>%)
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card shadow-sm" style="background-color: #E6D8DC;"
                        t-on-click="() => this.openHandoverReadyProperties()">
                        <div class="card-body pt-1 pb-0 text-center">
                            <div class="row pe-0">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Total Handover Ready</h6>
                            </div>
                            <div class="row pe-0">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Units</h6>
                            </div>
                            <div class="row">
                                <h3 style="text-color: #7A4E59">
                                    <t t-esc="state.handover_ready_units"/>
                                    (<t t-esc="formatAmount(state.handover_ready_units_percent)"/>%)
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card shadow-sm" style="background-color: #E6D8DC;"
                        t-on-click="() => this.openHandoveredPropertyUnits()">
                        <div class="card-body pt-1 pb-0 text-center">
                            <div class="row pe-0">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Total Handovered</h6>
                            </div>
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Units</h6>
                            </div>
                            <div class="row">
                                <h3 style="text-color: #7A4E59">
                                    <t t-esc="state.handovered_units"/>
                                    (<t t-esc="formatAmount(state.handovered_units_percent)"/>%)
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card shadow-sm" style="background-color: #F5EEF0; cursor: pointer;" 
                        t-on-click="() => this.openCanelledContracts()">                        
                        <div class="card-body pt-1 pb-0 text-center">
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Total Cancelled</h6>
                            </div>
                            <div class="row">
                                <h6 class="mb-0 mt-0 px-0 small" style="text-color: #7A4E59">Contracts</h6>
                            </div>
                            <div class="row text-white">
                                <h3 style="text-color: #7A4E59">
                                    <t t-esc="state.cancelled_contract_count"/>
                                    (<t t-esc="formatAmount(state.cancelled_contract_percent)"/>%)
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Installment Summary Table #####################################################-->
            
            <div class="o_section_divider">
                <span>Installment Summary</span>
            </div>

            <div class="row mb-5 mt-3">
                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6>Collected vs Remaining Amount per Installment (ETB)</h6>
                            <table class="table dashboard-table table-sm table-striped">
                                <thead>
                                    <tr> 
                                        <th class="text-center">Installment #</th> 
                                        <th class="text-center">Collected Amount</th> 
                                        <th class="text-center">Remaining Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.installment_summary || []" t-as="row" t-key="row.installment_number">
                                        <tr>
                                            <td class="text-center"> <t t-esc="row.installment_number"/> </td>
                                            <td class="text-end pe-2">
                                                <t t-esc="formatAmount(row.total_paid_amount)"/>
                                            </td>
                                            <td class="text-end pe-2">
                                                <t t-esc="formatAmount(row.total_remaining_amount)"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="fw-bold table-secondary">
                                        <td class="text-end pe-2">Total</td>
                                        <td class="text-end pe-2">
                                            <t t-esc="formatAmount(state.total_paid_amount)"/>
                                        </td>
                                        <td class="text-end pe-2">
                                            <t t-esc="formatAmount(state.total_remaining_amount)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6>To be Collected vs Overdue Amount per Installment (ETB)</h6>
                            <table class="table dashboard-table table-sm table-striped">
                                <thead>
                                    <tr> 
                                        <th class="text-center">Installment #</th> 
                                        <th class="text-center">To Be Collected</th> 
                                        <th class="text-center">Overdue Amount</th> 
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.installment_tobe_collected || []" t-as="row" t-key="row.installment_number">
                                        <tr>
                                            <td class="text-center"> 
                                                <t t-esc="row.installment_number"/> 
                                            </td>                                            
                                            <td class="text-end pe-2">
                                                <t t-esc="formatAmount(row.total_to_be_collected_amount)"/>
                                            </td>
                                            <td class="text-end pe-2">
                                                <t t-esc="formatAmount(row.total_collectable_overdue_amount)"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="fw-bold table-secondary">
                                        <td class="text-end pe-2">Total</td>
                                        <td class="text-end pe-2">
                                            <t t-esc="formatAmount(state.total_to_be_collected_amount)"/>
                                        </td>
                                        <td class="text-end pe-2">
                                            <t t-esc="formatAmount(state.total_collectable_overdue_amount)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Column Chart for Installment Summary ##############################################-->

            <div class="o_section_divider">
                <span>Installment Charts</span>
            </div>

            <div class="row mb-3 mt-2">
                <div class="col-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6>Installment: Collected vs Remaining Amount (ETB)</h6>
                            <div class="installment-chart-container">
                                <canvas t-ref="installmentChart"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6>Installment: To Be Collected vs Overdue Amount (ETB)</h6>
                            <div class="installment-chart-container">
                                <canvas t-ref="collectionChart"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- General Summary Table ###################################################################-->

            <div class="row mx-auto mb-5 mt-5 pt-3" style="border-top:2px solid #643F49;">
                <div class="col-md-8">
                    <div class="row">
                        <div class="col-md-2"></div>
                        <div class="col-md-2">
                            <div class="col-auto"><label class="mb-0 text-nowrap"></label></div>
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'site.region'"
                                    value="state.region2"
                                    update.bind="onRegionSelected2"
                                    getDomain.bind="getRegionDomain2"
                                    context="getContext2()"
                                    activeActions="activeActions2"
                                    fieldString="'Region'"
                                    isToMany="false"
                                    placeholder="'Region'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-auto"><label class="mb-0 text-nowrap"></label></div>
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'site.city'"
                                    value="state.city2"
                                    update.bind="onCitySelected2"
                                    getDomain.bind="getCityDomain2"
                                    context="getContext2()"
                                    activeActions="activeActions2"
                                    fieldString="'City'"
                                    isToMany="false"
                                    placeholder="'City'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-auto"><label class="mb-0 text-nowrap"></label></div>
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'re.site'"
                                    value="state.site2"
                                    update.bind="onSiteSelected2"
                                    getDomain.bind="getSiteDomain2"
                                    context="getContext2()"
                                    activeActions="activeActions2"
                                    fieldString="'Site'"
                                    isToMany="false"
                                    placeholder="'Site'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-auto"><label class="mb-0 text-nowrap"></label></div>
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'building.building'"
                                    value="state.building2"
                                    update.bind="onBuildingSelected2"
                                    getDomain.bind="getBuildingDomain2"
                                    context="getContext2()"
                                    activeActions="activeActions2"
                                    fieldString="'Building'"
                                    isToMany="false"
                                    placeholder="'Building'"
                                />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-auto"><label class="mb-0 text-nowrap"></label></div>
                            <div class="col">
                                <Many2XAutocomplete
                                    resModel="'re.floor'"
                                    value="state.floor2"
                                    update.bind="onFloorSelected2"
                                    getDomain.bind="getFloorDomain2"
                                    context="getContext2()"
                                    activeActions="activeActions2"
                                    fieldString="'Floor'"
                                    isToMany="false"
                                    placeholder="'Floor'"
                                />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="col-auto"><label class="mb-0 text-nowrap">From Date</label></div>
                            <div class="col"><input type="date" class="form-control form-control-sm" t-model="state.date_from"/></div>
                        </div>
                        <div class="col-md-5">
                            <div class="col-auto"><label class="mb-0 text-nowrap">To Date</label></div>
                            <div class="col"><input type="date" class="form-control form-control-sm" t-model="state.date_to"/></div>    
                        </div>
                        <div class="col-md-2">
                            <div class="col-auto"><label class="mb-0 text-nowrap"></label></div>
                            <div class="row align-items-right">
                                <button class="btn btn-sm" style="background-color: #643F49;color:white;" t-on-click="applyFilter2">Filter</button>
                            </div>
                        </div>
                    </div>                    
                </div>
            </div>
            
            <div class="o_section_divider">
                <span>General Summary</span>
            </div>

            <div class="row mb-5 mt-5">
                <div class="col-md-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <!-- <h5>General Summary</h5> -->
                            <table class="table dashboard-table table-hover table-striped table-sm">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-center col-fit">Title</th>
                                        <th scope="col" class="text-center">Sep</th>
                                        <th scope="col" class="text-center">Oct</th>
                                        <th scope="col" class="text-center">Nov</th>
                                        <th scope="col" class="text-center">Dec</th>
                                        <th scope="col" class="text-center">Jan</th>
                                        <th scope="col" class="text-center">Feb</th>
                                        <th scope="col" class="text-center">Mar</th>
                                        <th scope="col" class="text-center">Apr</th>
                                        <th scope="col" class="text-center">May</th>
                                        <th scope="col" class="text-center">Jun</th>
                                        <th scope="col" class="text-center">Jul</th>
                                        <th scope="col" class="text-center">Aug</th>
                                    </tr>
                                </thead>
                                <tbody>                                    
                                   
                                    <t t-foreach="state.total_requested_amount || []" t-as="row" t-key="row.id">
                                        <tr>
                                            <td class="text-start col-fit">Total Requested Amount (Birr)</td>
                                            <td class="text-center"><t t-esc="formatAmount(row.sep_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.oct_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.nov_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.dec_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jan_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.feb_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.mar_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.apr_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.may_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jun_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jul_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.aug_amount)"/></td>
                                        </tr>
                                    </t>
                                    
                                    <t t-foreach="state.total_collected_amount || []" t-as="row" t-key="row.id">
                                        <tr>
                                            <td class="text-start col-fit">Total Collected Amount (Birr)</td>
                                            <td class="text-center"><t t-esc="formatAmount(row.sep_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.oct_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.nov_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.dec_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jan_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.feb_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.mar_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.apr_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.may_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jun_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jul_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.aug_amount)"/></td>
                                        </tr>
                                    </t>                                    

                                    <t t-foreach="state.remaining_amount_tobe_collected || []" t-as="row" t-key="'paid_percentage'">
                                        <tr>
                                            <td class="text-start col-fit">Remaining Amount to be Collected</td>
                                            <td class="text-center"><t t-esc="formatAmount(row.sep_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.oct_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.nov_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.dec_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jan_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.feb_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.mar_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.apr_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.may_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jun_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.jul_amount)"/></td>
                                            <td class="text-center"><t t-esc="formatAmount(row.aug_amount)"/></td>
                                        </tr>
                                    </t>

                                    <t t-foreach="state.payment_request_letter || []" t-as="row" t-key="row.id">
                                        <tr>
                                            <td class="text-start col-fit">Customers Requested to Pay</td>
                                            <td class="text-center"><t t-esc="row.sep_count"/></td>
                                            <td class="text-center"><t t-esc="row.oct_count"/></td>
                                            <td class="text-center"><t t-esc="row.nov_count"/></td>
